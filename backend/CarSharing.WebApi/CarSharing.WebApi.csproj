      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CarSharing.Application\CarSharing.Application.csproj" />
    <ProjectReference Include="..\CarSharing.Infrastructure\CarSharing.Infrastructure.csproj" />
  </ItemGroup>

</Project>
